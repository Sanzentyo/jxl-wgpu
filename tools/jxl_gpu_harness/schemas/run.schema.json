{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jxl_gpu_harness run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "generated_unix_ms", "package_version", "target_os", "target_arch", "adapters", "cases"],
  "properties": {
    "schema_version": { "const": 4 },
    "command": { "type": "string", "minLength": 1 },
    "generated_unix_ms": { "type": "integer", "minimum": 0 },
    "package_version": { "type": "string", "minLength": 1 },
    "target_os": { "type": "string", "minLength": 1 },
    "target_arch": { "type": "string", "minLength": 1 },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/adapter" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "codec_cases": { "type": "array", "items": { "$ref": "#/$defs/codec_case" } }
  },
  "$defs": {
    "status": {
      "enum": ["passed", "failed", "unsupported", "incomplete", "unavailable", "error"]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor", "device", "device_type", "backend", "driver", "driver_info", "pci_bus_id", "subgroup_min_size", "subgroup_max_size", "features", "max_buffer_size", "max_storage_buffer_binding_size", "max_workgroup_storage_size", "max_compute_invocations_per_workgroup"],
      "properties": {
        "name": { "type": "string" },
        "vendor": { "type": "integer", "minimum": 0 },
        "device": { "type": "integer", "minimum": 0 },
        "device_type": { "type": "string" },
        "backend": { "type": "string" },
        "driver": { "type": "string" },
        "driver_info": { "type": "string" },
        "pci_bus_id": { "type": "string" },
        "subgroup_min_size": { "type": "integer", "minimum": 0 },
        "subgroup_max_size": { "type": "integer", "minimum": 0 },
        "features": { "type": "string" },
        "max_buffer_size": { "type": "integer", "minimum": 0 },
        "max_storage_buffer_binding_size": { "type": "integer", "minimum": 0 },
        "max_workgroup_storage_size": { "type": "integer", "minimum": 0 },
        "max_compute_invocations_per_workgroup": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "operation", "backend", "status", "output_hash", "metrics", "threshold", "timing", "message"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "output_hash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "metrics": { "type": ["object", "null"] },
        "threshold": { "type": ["object", "null"] },
        "timing": { "type": ["object", "null"] },
        "message": { "type": ["string", "null"] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "warmup", "iterations", "burst_size", "concurrency", "max_frame_slots"],
      "properties": {
        "kind": { "enum": ["single_latency", "warm_sequential", "concurrent_burst", "concurrent", "animation"] },
        "warmup": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 1 },
        "burst_size": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "max_frame_slots": { "type": "integer", "minimum": 1 }
      }
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "component", "code", "detail"],
      "properties": {
        "kind": { "enum": ["unsupported", "incomplete", "unavailable", "invalid_input", "verification", "backend"] },
        "component": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "timing_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "minimum_ns", "median_ns", "p95_ns", "mean_ns", "standard_deviation_ns"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "minimum_ns": { "type": "integer", "minimum": 0 },
        "median_ns": { "type": "integer", "minimum": 0 },
        "p95_ns": { "type": "integer", "minimum": 0 },
        "mean_ns": { "type": "number", "minimum": 0 },
        "standard_deviation_ns": { "type": "number", "minimum": 0 }
      }
    },
    "codec_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_latency", "workload"],
      "properties": {
        "operation_latency": { "$ref": "#/$defs/timing_statistics" },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "parallelism", "execution_model", "wall_ns", "operations_per_second"],
          "properties": {
            "operations": { "type": "integer", "minimum": 1 },
            "parallelism": { "type": "integer", "minimum": 1 },
            "execution_model": { "enum": ["sequential", "barrier_synchronized_host_fanout", "persistent_host_workers", "animation_session"] },
            "wall_ns": { "type": "integer", "minimum": 0 },
            "operations_per_second": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "cpu_baseline_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "detail"],
      "properties": {
        "kind": { "enum": ["unsupported_contract", "executable_unavailable", "timeout", "process_exit", "invalid_output", "io", "nondeterministic_output", "verification_mismatch", "worker_panic"] },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 16408 }
      }
    },
    "cpu_baseline_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "executable", "version", "version_query_error", "process_model"],
      "properties": {
        "implementation": { "const": "libjxl_djxl" },
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "version_query_error": { "type": ["string", "null"] },
        "process_model": { "const": "external_process_per_operation" }
      }
    },
    "cpu_baseline_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup", "iterations", "timeout_ms_per_process"],
      "properties": {
        "warmup": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 1 },
        "timeout_ms_per_process": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "cpu_baseline_cold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ns", "includes_process_spawn", "includes_output_file_io_and_hash", "input_bytes", "decoded_bytes", "width", "height", "output_hash"],
      "properties": {
        "elapsed_ns": { "type": "integer", "minimum": 0 },
        "includes_process_spawn": { "const": true },
        "includes_output_file_io_and_hash": { "const": true },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "decoded_bytes": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "output_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cpu_baseline_warm_repetition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "minimum_ns", "p50_ns", "p95_ns", "mean_ns", "wall_ns", "operations_per_second", "parallelism", "workload_execution_model", "process_model", "total_input_bytes", "total_decoded_bytes", "decoded_bytes_per_operation", "width", "height", "output_hash"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "minimum_ns": { "type": "integer", "minimum": 0 },
        "p50_ns": { "type": "integer", "minimum": 0 },
        "p95_ns": { "type": "integer", "minimum": 0 },
        "mean_ns": { "type": "number", "minimum": 0 },
        "wall_ns": { "type": "integer", "minimum": 0 },
        "operations_per_second": { "type": "number", "minimum": 0 },
        "parallelism": { "type": "integer", "minimum": 1 },
        "workload_execution_model": { "enum": ["sequential", "barrier_synchronized_host_fanout", "persistent_host_workers", "animation_session"] },
        "process_model": { "const": "external_process_per_operation" },
        "total_input_bytes": { "type": "integer", "minimum": 0 },
        "total_decoded_bytes": { "type": "integer", "minimum": 1 },
        "decoded_bytes_per_operation": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "output_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cpu_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provenance", "configuration", "cold", "warm_repetition", "verified", "issue"],
      "properties": {
        "status": { "enum": ["completed", "verification_failed", "skipped", "unsupported", "timed_out", "error"] },
        "provenance": { "$ref": "#/$defs/cpu_baseline_provenance" },
        "configuration": { "$ref": "#/$defs/cpu_baseline_configuration" },
        "cold": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cpu_baseline_cold" }] },
        "warm_repetition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cpu_baseline_warm_repetition" }] },
        "verified": { "type": ["boolean", "null"] },
        "issue": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cpu_baseline_issue" }] }
      }
    },
    "codec_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "path", "operation", "workload", "output_target", "status", "adapter", "pixel_format", "size_class", "declared_extent", "input_bytes", "output_bytes", "gpu_output_logical_bytes", "frame_count", "codec_submissions", "codec_completion_waits", "display_submissions", "display_completion_waits", "readback_submissions", "readback_completion_waits", "readback_logical_bytes", "readback_staging_bytes", "readback_source_frames", "readback_max_frames_per_submission", "readback_mode", "coalesced_gpu_batching", "output_hash", "timing", "issue", "cpu_baseline"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["decode", "encode", "round_trip"] },
        "workload": { "$ref": "#/$defs/workload" },
        "output_target": { "enum": ["gpu_resident", "display_texture", "cpu_readback"] },
        "status": { "$ref": "#/$defs/status" },
        "adapter": { "type": ["string", "null"] },
        "pixel_format": {
          "enum": ["u8", "s8", "u16", "u32", "s32", "s16", "2s16", "f32", "f64", "2f32", "y8", "y16", "i420", "i422", "i444", "nv12", "nv21", "nv16", "nv61", "nv24", "nv42", "p010", "p012", "p016", "yuyv", "uyvy", "rgb8", "bgr8", "rgba8", "bgra8", "rgb8_planar", "bgr8_planar", "rgba8_planar", "bgra8_planar"]
        },
        "size_class": { "enum": ["auto", "small", "odd", "large"] },
        "declared_extent": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/extent" }] },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "gpu_output_logical_bytes": { "type": "integer", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 },
        "codec_submissions": { "type": "integer", "minimum": 0 },
        "codec_completion_waits": { "type": "integer", "minimum": 0 },
        "display_submissions": { "type": "integer", "minimum": 0 },
        "display_completion_waits": { "type": "integer", "minimum": 0 },
        "readback_submissions": { "type": "integer", "minimum": 0 },
        "readback_completion_waits": { "type": "integer", "minimum": 0 },
        "readback_logical_bytes": { "type": "integer", "minimum": 0 },
        "readback_staging_bytes": { "type": "integer", "minimum": 0 },
        "readback_source_frames": { "type": "integer", "minimum": 0 },
        "readback_max_frames_per_submission": { "type": "integer", "minimum": 0 },
        "readback_mode": { "oneOf": [{ "type": "null" }, { "enum": ["staged_copy", "direct_map", "aggregate_staged_copy"] }] },
        "coalesced_gpu_batching": { "const": false },
        "output_hash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
        "timing": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/codec_timing" }] },
        "issue": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/issue" }] },
        "cpu_baseline": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cpu_baseline" }] }
      }
    }
  }
}
